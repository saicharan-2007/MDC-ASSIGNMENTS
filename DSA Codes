# 1. Numbers divisible by 7 but not multiples of 3
print("Numbers divisible by 7 but not multiples of 3:")
i = 2000
first = True

while i <= 3200:
    if i % 7 == 0 and i % 3 != 0:
        if not first:
            print(",", end="")
        print(i, end="")
        first = False
    i += 1

print()
print()

# 2. Convert a list of characters into a string
characters = ["C", "O", "D", "I", "N", "G"]
result = ""
i = 0

while i < len(characters):
    result = result + characters[i]
    i += 1

print("String:", result)
print()

# 3. Generate a dictionary containing (i, i*i)
n = 5
dictionary = {}
i = 1

while i <= n:
    dictionary[i] = i * i
    i += 1

print("Dictionary:", dictionary)
